{
  "name": "smt-wms-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:frontend": "vite build",
    "start": "NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:frontend": "tsc -p web/client/tsconfig.json --noEmit",
    "lint:server": "tsc -p web/server/tsconfig.json --noEmit",
    "test": "tsx --test web/shared/domain/*.test.ts web/server/utils/*.test.ts web/server/db/*.test.ts web/client/utils/*.test.ts web/client/services/*.test.ts",
    "db:push": "drizzle-kit push --config=web/server/db/drizzle.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
