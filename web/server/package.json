{
  "name": "@smt-wms/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SMT-WMS Node.js Express + Drizzle ORM + PostgreSQL 后端服务",
  "scripts": {
    "dev": "tsx index.ts",
    "start": "NODE_ENV=production tsx index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test utils/*.test.ts db/*.test.ts",
    "db:push": "drizzle-kit push --config=db/drizzle.config.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
