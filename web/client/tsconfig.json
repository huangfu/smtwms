{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../shared/types/**/*.ts",
    "../shared/domain/**/*.ts"
  ],
  "exclude": [
    "./**/*.test.ts",
    "../shared/**/*.test.ts",
    "../server/**/*",
    "../../node_modules"
  ]
}
