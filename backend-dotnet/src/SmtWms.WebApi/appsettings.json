{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5173"
    ]
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=smtwms.db",
    "AutoSyncStructure": true,
    "LogSql": false,
    "SlaveConnectionStrings": [],
    "AdditionalDatabases": {}
  },
  "DatabaseExamples": {
    "SqlServer_MSSQL": {
      "Provider": "SqlServer",
      "ConnectionString": "Server=127.0.0.1,1433;Database=SmtWmsDb;User Id=sa;Password=YourStrong!Passw0rd;TrustServerCertificate=True;Encrypt=True;"
    },
    "PostgreSQL": {
      "Provider": "PostgreSQL",
      "ConnectionString": "Host=127.0.0.1;Port=5432;Database=smt_wms;Username=postgres;Password=YourPassword;"
    },
    "MySql": {
      "Provider": "MySql",
      "ConnectionString": "Server=127.0.0.1;Port=3306;Database=smt_wms;Uid=root;Pwd=YourPassword;Charset=utf8mb4;"
    }
  }
}
